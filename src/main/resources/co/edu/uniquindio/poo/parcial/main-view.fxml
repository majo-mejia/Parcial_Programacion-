<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="6" style="-fx-padding: 12;">
            <Label text="SMARTGYM"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            <Label text="Sistema de gestión del gimnasio" />
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <Tab text="Clientes">
                    <content>
                        <fx:include source="cliente-view.fxml" />
                    </content>
                </Tab>

                <Tab text="Entrenadores">
                    <content>
                        <fx:include source="entrenador-view.fxml" />
                    </content>
                </Tab>

                <Tab text="Planes">
                    <content>
                        <fx:include source="plan-view.fxml" />
                    </content>
                </Tab>

                <Tab text="Servicios">
                    <content>
                        <fx:include source="servicio-view.fxml" />
                    </content>
                </Tab>

                <Tab text="Inscripciones">
                    <content>
                        <fx:include source="inscripcion-view.fxml" />
                    </content>
                </Tab>

                <Tab text="Consultas">
                    <content>
                        <fx:include source="consultas-view.fxml" />
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </center>

</BorderPane>
