<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parcial.controller.PlanController">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <top>
        <VBox spacing="8">
            <GridPane hgap="8" vgap="8">

                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="tipo" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Código:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="codigo" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="nombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Descripción:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="descripcion" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Duración (meses):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="duracion" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Valor mensual:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <TextField fx:id="valor" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="estado" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Beneficio:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <TextField fx:id="beneficio" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                <Label text="Sesiones:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="sesiones" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Especialidad:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <ComboBox fx:id="especialidad" prefWidth="180"
                          GridPane.columnIndex="3" GridPane.rowIndex="4"/>

                <Label text="Objetivo:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="objetivo" GridPane.columnIndex="1"
                           GridPane.columnSpan="3" GridPane.rowIndex="5"/>

            </GridPane>

            <HBox spacing="8">
                <Button text="Crear plan" onAction="#crearPlan"/>
                <Button text="Eliminar seleccionado" onAction="#eliminarPlan"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="columnaCodigo" text="Código" prefWidth="100"/>
                <TableColumn fx:id="columnaNombre" text="Nombre" prefWidth="180"/>
                <TableColumn fx:id="columnaTipo" text="Tipo" prefWidth="150"/>
                <TableColumn fx:id="columnaDuracion" text="Meses" prefWidth="80"/>
                <TableColumn fx:id="columnaValor" text="Valor mensual" prefWidth="120"/>
            </columns>
        </TableView>
    </center>

</BorderPane>
